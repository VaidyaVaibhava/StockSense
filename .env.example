# ========================================
# StockSense — Local Development Environment
# ========================================
# Copy this file to .env.local (never commit .env.local)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StockSense

# JWT Authentication (change in production!)
JWT_SECRET=stocksense_dev_jwt_secret_2026_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h

# AI Agent Keys — Mastra orchestration engine
# Plug in at least ONE provider key to activate live AI responses
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Firebase Authentication (separate portals)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Data file path (relative to project root)
DB_FILE_PATH=data/stocksense_db.json
